# Backend environment template for local/dev/CodeSandbox
# Copy to Backend/.env for local use, or set these in CodeSandbox Secrets.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

OAUTH_REDIRECT_URL=http://localhost:8080/auth/callback
FRONTEND_URL=http://localhost:8080

MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=csv,xlsx,json
UPLOAD_DIR=./uploads
MODEL_PATH=../AI/ML/smurf_hunter_model.pt

DEBUG=true
CORS_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
